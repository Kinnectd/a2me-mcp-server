{
  "name": "a2me-mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing read-only A2Me family-context tools for AI assistants",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run build:widgets",
    "build:server": "tsc",
    "build:widgets": "tsx widgets/build-widgets.mts",
    "dev": "tsx src/index.ts",
    "start": "node --import ./dist/tracing.js dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "format": "prettier --write .",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "a2me",
    "family",
    "context"
  ],
  "author": "Kinnectd LLC",
  "license": "MIT",
  "homepage": "https://a2me.app/features/ai-integration",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kinnectd/a2me-mcp-server.git"
  },
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.2",
    "@opentelemetry/instrumentation-express": "^0.71.1",
    "@opentelemetry/instrumentation-http": "^0.223.2",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-node": "^0.223.2",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.4",
    "jose": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.4.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12"
  }
}
